{
  "name": "vcpkg",
  "description": "C/C++ library package manager",
  "tags": ["cpp", "dev", "package-manager"],
  "executable": "vcpkg.exe",
  "packages": {
    "scoop": "vcpkg"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "VCPKG_ROOT": "${XDG_DATA_HOME}/vcpkg",
      "VCPKG_DOWNLOADS": "${XDG_CACHE_HOME}/vcpkg/downloads"
    },
    "native": {
      "VCPKG_ROOT": {
        "paths": ["${HOME}/vcpkg"],
        "move": false,
        "guide": "vcpkg roots are chosen when you clone it; follow https://learn.microsoft.com/vcpkg/get_started/get-started to relocate it."
      }
    },
    "dirs": [
      "${XDG_DATA_HOME}/vcpkg",
      "${XDG_CACHE_HOME}/vcpkg/downloads"
    ]
  },
  "aliases": {},
  "picker": null
}
