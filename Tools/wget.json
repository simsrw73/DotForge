{
  "name": "wget",
  "description": "Non-interactive network downloader",
  "tags": [
    "network",
    "download"
  ],
  "executable": "wget.exe",
  "roles": { "url-fetch": {} },
  "packages": {
    "scoop": "wget",
    "choco": "wget"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "WGETRC": "${XDG_CONFIG_HOME}/wget/wgetrc"
    },
    "native": {
      "WGETRC": ["${HOME}/.wgetrc"],
      "${XDG_CONFIG_HOME}/wget/wgetrc": []
    },
    "dirs": [
      "${XDG_CONFIG_HOME}/wget"
    ]
  },
  "setup": {
    "seed": {
      "${XDG_CONFIG_HOME}/wget/wgetrc": "wget/wgetrc"
    }
  },
  "aliases": {},
  "picker": null
}
