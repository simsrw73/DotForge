{
  "name": "cargo",
  "description": "Rust package manager (installs crates from crates.io)",
  "tags": ["rust", "dev", "package-manager"],
  "executable": "cargo.exe",
  "roles": { "rust-package-manager": { "priority": 10 } },
  "requires": ["rustup"],
  "packages": {},
  "installs": { "from": "crates", "install": ["cargo", "install", "{id}"], "update": ["cargo", "install", "{id}"], "remove": ["cargo", "uninstall", "{id}"], "list": "Get-DFCargoInstalled", "batch": true },
  "aliases": {},
  "picker": null
}
