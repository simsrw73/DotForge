{
  "name": "choco",
  "description": "Chocolatey — Windows package manager",
  "tags": [
    "package-manager",
    "windows"
  ],
  "executable": "choco.exe",
  "roles": { "package-manager": { "priority": 10 } },
  "packages": {},
  "installs": { "from": "choco", "command": ["choco", "install", "{id}", "-y"], "batch": true, "elevate": true },
  "xdg": {
    "compliance": "none",
    "method": "default"
  },
  "aliases": {},
  "after": ["gsudo"],
  "picker": "custom"
}
