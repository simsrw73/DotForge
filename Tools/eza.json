{
  "name": "eza",
  "description": "Modern ls replacement with icons, Git integration, and color",
  "tags": ["file", "directory", "ls"],
  "executable": "eza.exe",
  "role": "listing",
  "packages": {
    "scoop": "eza",
    "winget": "eza-community.eza",
    "choco": "eza"
  },
  "xdg": {
    "compliance": "none",
    "method": "default"
  },
  "aliases": {
    "ls": {
      "command": "eza",
      "args": [
        "--color=auto",
        "--icons=auto",
        "--group-directories-first",
        "--git"
      ]
    },
    "ll": {
      "command": "eza",
      "args": ["--long", "--header", "--color=auto", "--icons=auto", "--group-directories-first", "--git"]
    },
    "la": {
      "command": "eza",
      "args": ["--almost-all", "--long", "--header", "--color=auto", "--icons=auto", "--group-directories-first", "--git"]
    },
    "tree": {
      "command": "eza",
      "args": ["--tree", "--color=auto", "--icons=auto", "--group-directories-first"]
    }
  },
  "picker": {
    "alias": "ff",
    "function": "Select-File",
    "list": "eza --icons -1 --color=always",
    "list_accepts_path": true,
    "preview": "Start-Sleep -Milliseconds 1000; bat --color=always --line-range=:200 {}",
    "preview_window": "right:60%",
    "ansi": true,
    "header": "Select file  [Enter to open]",
    "action": "output"
  }
}
