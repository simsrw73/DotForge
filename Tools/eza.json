{
  "name": "eza",
  "description": "Modern ls replacement with icons, Git integration, and color",
  "tags": ["file", "directory", "ls"],
  "executable": "eza.exe",
  "packages": {
    "scoop": "eza",
    "winget": "eza-community.eza",
    "choco": "eza"
  },
  "xdg": {
    "compliance": "none",
    "method": "default"
  },
  "roles": {
    "listing": {
      "priority": 20,
      "flags": {
        "color": ["--color=auto"], "color-always": ["--color=always"],
        "icons": ["--icons=auto"], "icons-always": ["--icons=always"],
        "dirs-first": ["--group-directories-first"], "literal": ["--no-quotes"],
        "long": ["--long"], "all": ["--all"], "git": ["--git"],
        "tree": ["--tree"], "one-per-line": ["-1"]
      }
    }
  },
  "theme": {
    "key": "EzaTheme",
    "default": "catppuccin-mocha",
    "files": "eza",
    "env": { "EZA_CONFIG_DIR": "{theme}" }
  },
  "aliases": {},
  "picker": null
}
