{
  "name": "mdv",
  "description": "Terminal markdown viewer with themes and syntax highlighting",
  "tags": [
    "markdown",
    "viewer",
    "text"
  ],
  "executable": "mdv.exe",
  "roles": { "markdown-viewer": {} },
  "packages": {
    "crates": "mdv"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "MDV_CONFIG_PATH": "${XDG_CONFIG_HOME}/mdv"
    },
    "native": {
      "MDV_CONFIG_PATH": []
    },
    "dirs": [
      "${XDG_CONFIG_HOME}/mdv"
    ]
  },
  "theme": {
    "key": "MdvTheme",
    "default": "catppuccin-mocha",
    "map": { "catppuccin-mocha": "catppuccin" },
    "valid": ["terminal", "solarized-dark", "nord", "tokyonight", "kanagawa", "gruvbox", "monokai", "material-ocean", "catppuccin"],
    "fallback": "terminal"
  },
  "aliases": {},
  "picker": null
}
