{
  "name": "psreadline",
  "type": "module",
  "description": "Enhanced command-line editing and syntax highlighting for PowerShell",
  "tags": ["readline", "completion", "theme", "module"],
  "executable": "PSReadLine",
  "dependsOn": [],
  "prewarm": false,
  "xdg": { "compliance": "none", "method": "default" },
  "settings": {
    "editMode":                    "Emacs",
