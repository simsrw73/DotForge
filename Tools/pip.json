{
  "name": "pip",
  "description": "Python package installer (installs into the user site-packages)",
  "tags": ["python", "dev", "package-manager"],
  "executable": "pip.exe",
  "roles": { "python-package-manager": { "priority": 10 } },
  "requires": ["python"],
  "installs": { "from": "pypi", "install": ["pip", "install", "--user", "{id}"], "update": ["pip", "install", "--user", "--upgrade", "{id}"], "remove": ["pip", "uninstall", "-y", "{id}"], "list": "Get-DFPipInstalled", "outdated": "Get-DFPipOutdated", "batch": true },
  "aliases": {},
  "picker": null
}
