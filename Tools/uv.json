{
  "name": "uv",
  "description": "Extremely fast Python package and project manager",
  "tags": [
    "python",
    "dev",
    "package-manager"
  ],
  "executable": "uv.exe",
  "packages": {
    "scoop": "uv",
    "winget": "astral-sh.uv"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "UV_CACHE_DIR": "${XDG_CACHE_HOME}/uv",
      "UV_DATA_DIR": "${XDG_DATA_HOME}/uv"
    },
    "dirs": [
      "${XDG_CACHE_HOME}/uv",
      "${XDG_DATA_HOME}/uv"
    ]
  },
  "aliases": {},
  "picker": null
}