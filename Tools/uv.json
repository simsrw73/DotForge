{
  "name": "uv",
  "description": "Extremely fast Python package and project manager",
  "tags": [
    "python",
    "dev",
    "package-manager"
  ],
  "executable": "uv.exe",
  "roles": { "version-manager": {}, "python-package-manager": { "priority": 30 } },
  "packages": {
    "scoop": "uv",
    "winget": "astral-sh.uv"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "UV_CACHE_DIR": "${XDG_CACHE_HOME}/uv",
      "UV_TOOL_DIR": "${XDG_DATA_HOME}/uv/tools",
      "UV_PYTHON_INSTALL_DIR": "${XDG_DATA_HOME}/uv/python"
    },
    "native": {
      "UV_TOOL_DIR": {
        "paths": ["${APPDATA}/uv/tools"],
        "move": false,
        "block": false,
        "guide": "uv's old tools folder holds the environments of the tools it installed, which don't work once moved: run uv tool list with UV_TOOL_DIR pointing there, install each again with uv tool install, then delete it."
      },
      "UV_PYTHON_INSTALL_DIR": {
        "paths": ["${APPDATA}/uv/python"],
        "move": false,
        "block": false,
        "guide": "uv's old Python folder holds the Pythons it installed: install the versions you use again with uv python install, then delete it."
      }
    },
    "dirs": [
      "${XDG_CACHE_HOME}/uv"
    ]
  },
  "installs": [
    { "from": "pypi", "install": ["uv", "tool", "install", "{id}"], "update": ["uv", "tool", "upgrade", "{id}"], "remove": ["uv", "tool", "uninstall", "{id}"], "list": "Get-DFUvInstalled" },
    { "from": "uv", "install": ["uv", "python", "install", "--default", "{id}"] }
  ],
  "aliases": {},
  "picker": "custom"
}
