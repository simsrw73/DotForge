{
  "name": "lsd",
  "description": "Modern ls replacement with colors, icons, and tree view",
  "tags": ["file", "directory", "ls"],
  "executable": "lsd.exe",
  "packages": {
    "scoop": "lsd",
    "winget": "lsd-rs.lsd",
    "choco": "lsd"
  },
  "xdg": {
    "compliance": "none",
    "method": "wrapper",
    "native": {
      "${XDG_CONFIG_HOME}/lsd/config.yaml": ["${APPDATA}/lsd/config.yaml", "${HOME}/.config/lsd/config.yaml"]
    },
    "instructions": "lsd's --config-file panics on a path that doesn't exist (verified lsd 1.2.0), so its wrapper passes it only when $XDG_CONFIG_HOME/lsd/config.yaml exists."
  },
  "wrapper": {
    "args": [ { "ifFile": "${XDG_CONFIG_HOME}/lsd/config.yaml", "args": ["--config-file", "{file}"] } ]
  },
  "roles": {
    "listing": {
      "priority": 10,
      "aliases": {
        "ls":   { "command": "lsd", "args": ["--color=auto", "--icon=auto", "--group-directories-first", "--literal"] },
        "ll":   { "command": "lsd", "args": ["--all", "--long", "--header", "--literal"] },
        "la":   { "command": "lsd", "args": ["--all", "--literal"] },
        "tree": { "command": "lsd", "args": ["--tree", "--literal"] }
      }
    }
  },
  "aliases": {},
  "picker": null
}
