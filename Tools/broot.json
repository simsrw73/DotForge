{
  "name": "broot",
  "description": "Interactive file browser with fuzzy search; br moves the shell to the folder you leave it in",
  "tags": [
    "file",
    "browser",
    "navigation"
  ],
  "executable": "broot.exe",
  "roles": { "directory-jump": { "priority": 3 } },
  "packages": {
    "scoop": "broot",
    "winget": "Dystroy.broot",
    "choco": "broot"
  },
  "xdg": {
    "compliance": "full",
    "method": "env",
    "vars": { "BROOT_CONFIG_DIR": "${XDG_CONFIG_HOME}/broot" },
    "native": {
      "BROOT_CONFIG_DIR": ["${APPDATA}/dystroy/broot/config"],
      "${XDG_CONFIG_HOME}/broot/conf.hjson": [],
      "${XDG_CONFIG_HOME}/broot/verbs.hjson": []
    }
  },
  "theme": { "key": "BrootTheme", "default": "catppuccin-mocha", "files": "broot" },
  "setup": {
    "seed": {
      "${XDG_CONFIG_HOME}/broot/conf.hjson": "broot/conf.hjson",
      "${XDG_CONFIG_HOME}/broot/verbs.hjson": "broot/verbs.hjson"
    }
  },
  "aliases": {},
  "picker": null
}