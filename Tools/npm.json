{
  "name": "npm",
  "description": "Node.js package manager",
  "tags": [
    "node",
    "javascript",
    "dev",
    "package-manager"
  ],
  "executable": "npm.cmd",
  "requires": ["node"],
  "packages": {},
  "roles": { "js-package-manager": { "priority": 30 } },
  "installs": { "from": "npm", "command": ["npm", "install", "-g", "{id}"], "batch": true },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "NPM_CONFIG_USERCONFIG": "${XDG_CONFIG_HOME}/npm/npmrc",
      "NODE_REPL_HISTORY": "${XDG_DATA_HOME}/node_repl_history"
    },
    "dirs": [
      "${XDG_CONFIG_HOME}/npm"
    ]
  },
  "aliases": {
    "nls": {
      "command": "npm",
      "args": [
        "list",
        "-g",
        "--depth=0"
      ]
    }
  },
  "picker": null
}