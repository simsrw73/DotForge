{
  "name": "npm",
  "description": "Node.js package manager",
  "tags": [
    "node",
    "javascript",
    "dev",
    "package-manager"
  ],
  "executable": "npm.cmd",
  "requires": ["node"],
  "packages": {},
  "roles": { "js-package-manager": { "priority": 30 } },
  "installs": { "from": "npm", "install": ["npm", "install", "-g", "{id}"], "batch": true, "update": ["npm", "install", "-g", "{id}@latest"], "remove": ["npm", "uninstall", "-g", "{id}"], "list": "Get-DFNpmInstalled", "outdated": "Get-DFNpmOutdated" },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "NPM_CONFIG_USERCONFIG": "${XDG_CONFIG_HOME}/npm/npmrc",
      "NODE_REPL_HISTORY": "${XDG_DATA_HOME}/node_repl_history",
      "NPM_CONFIG_CACHE": "${XDG_CACHE_HOME}/npm"
    },
    "native": {
      "NPM_CONFIG_USERCONFIG": ["${HOME}/.npmrc"],
      "NODE_REPL_HISTORY": ["${HOME}/.node_repl_history"],
      "NPM_CONFIG_CACHE": {
        "paths": ["${LOCALAPPDATA}/npm-cache"],
        "move": false,
        "block": false,
        "guide": "it's only npm's download cache; delete it to free the space."
      }
    },
    "dirs": [
      "${XDG_CONFIG_HOME}/npm"
    ]
  },
  "aliases": {
    "nls": {
      "command": "npm",
      "args": [
        "list",
        "-g",
        "--depth=0"
      ]
    }
  },
  "picker": "custom"
}
