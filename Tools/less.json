{
  "name": "less",
  "description": "Opposite of more — terminal pager",
  "tags": [
    "pager",
    "viewer"
  ],
  "executable": "less.exe",
  "executableExclude": ["*\\Git\\usr\\bin\\*"],
  "roles": { "pager": { "priority": 10, "flags": { "quit-if-one-screen": ["-F"], "raw-color": ["-R"], "keep-screen": ["-X"], "mouse": ["--mouse"], "theme": [] } } },
  "packages": {
    "scoop": "less",
    "winget": "jftuga.less",
    "choco": "less"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "LESSHISTFILE": "${XDG_STATE_HOME}/less/history",
      "LESSKEYIN": "${XDG_CONFIG_HOME}/less/lesskey"
    },
    "native": {
      "LESSHISTFILE": ["${XDG_STATE_HOME}/lesshst", "${XDG_DATA_HOME}/lesshst", "${HOME}/.lesshst", "${HOME}/_lesshst"],
      "LESSKEYIN": ["${HOME}/.config/lesskey", "${XDG_CONFIG_HOME}/lesskey", "${HOME}/.lesskey", "${HOME}/_lesskey"],
      "${XDG_CONFIG_HOME}/less/lesskey": []
    },
    "dirs": [
      "${XDG_STATE_HOME}/less",
      "${XDG_CONFIG_HOME}/less"
    ]
  },
  "setup": {
    "seed": { "${XDG_CONFIG_HOME}/less/lesskey": "less/lesskey" }
  },
  "aliases": {},
  "picker": null
}
