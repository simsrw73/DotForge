{
  "name": "zoxide",
  "description": "Smarter cd that learns your most-used directories",
  "tags": [
    "navigation",
    "cd",
    "directory"
  ],
  "executable": "zoxide.exe",
  "roles": { "navigation": { "priority": 10, "directories": ["zoxide", "query", "--list"], "enter": "cd" } },
  "after": ["oh-my-posh",  "starship"],
  "packages": {
    "scoop": "zoxide",
    "winget": "ajeetdsouza.zoxide",
    "choco": "zoxide"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "_ZO_DATA_DIR": "${XDG_DATA_HOME}/zoxide"
    },
    "native": {
      "_ZO_DATA_DIR": ["${XDG_DATA_HOME}/zoxide", "${HOME}/.local/share/zoxide", "${LOCALAPPDATA}/zoxide", "${HOME}/Library/Application Support/zoxide"]
    },
    "dirs": []
  },
  "aliases": {},
  "picker": {
    "alias": "fzo",
    "function": "Select-Directory",
    "list": "zoxide query --list",
    "preview": "eza --icons --color=always {}",
    "preview_window": "right:60%",
    "ansi": false,
    "header": "Select directory  [Enter to cd]",
    "action": "Set-Location {}"
  }
}
