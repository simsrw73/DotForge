{
  "name": "claude-code",
  "description": "Claude Code, Anthropic's agentic coding tool for the terminal",
  "tags": ["ai", "coding-agent", "dev"],
  "executable": "claude.exe",
  "packages": {
    "script": {
      "id": "https://claude.ai/install.ps1",
      "installed": "${HOME}/.local/bin/claude.exe",
      "update": ["claude", "update"],
      "remove": ["${HOME}/.local/bin/claude.exe", "${HOME}/.local/share/claude"]
    },
    "winget": "Anthropic.ClaudeCode",
    "npm": "@anthropic-ai/claude-code"
  },
  "install": { "prefer": ["script"] },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": { "CLAUDE_CONFIG_DIR": "${XDG_CONFIG_HOME}/claude" },
    "native": {
      "CLAUDE_CONFIG_DIR": ["${HOME}/.claude"],
      "${XDG_CONFIG_HOME}/claude/.claude.json": ["${HOME}/.claude.json"]
    },
    "instructions": "Claude Code keeps settings, history and plugins in CLAUDE_CONFIG_DIR, and ~/.claude.json there too. Its native installer always installs to ~/.local/bin and ~/.local/share/claude (the XDG defaults) and reads no variables; the desktop app needs CLAUDE_CONFIG_DIR in the Windows environment (Set-DFDesktopEnv claude-code)."
  },
  "desktop": ["CLAUDE_CONFIG_DIR"],
  "theme": {
    "key": "ClaudeTheme",
    "default": "catppuccin-mocha",
    "map": {
      "catppuccin-mocha": "custom:catppuccin:catppuccin-mocha",
      "catppuccin-macchiato": "custom:catppuccin:catppuccin-macchiato",
      "catppuccin-frappe": "custom:catppuccin:catppuccin-frappe",
      "catppuccin-latte": "custom:catppuccin:catppuccin-latte",
      "dracula": "custom:dracula:dracula",
      "nord": "custom:nord:nord",
      "tokyo-night": "custom:tokyo-night:tokyo-night",
      "gruvbox-dark": "custom:gruvbox:gruvbox-dark",
      "gruvbox-light": "custom:gruvbox:gruvbox-light",
      "everforest-dark": "custom:everforest:everforest-dark",
      "everforest-light": "custom:everforest:everforest-light",
      "rose-pine": "custom:rose-pine:rose-pine",
      "rose-pine-moon": "custom:rose-pine:rose-pine-moon",
      "rose-pine-dawn": "custom:rose-pine:rose-pine-dawn",
      "solarized-dark": "custom:solarized:solarized",
      "solarized-light": "custom:solarized:solarized-light",
      "one-dark": "custom:one-dark:one-dark",
      "onehalf-dark": "custom:one-dark:onehalf-dark",
      "onehalf-light": "custom:one-dark:onehalf-light",
      "monokai": "custom:monokai:monokai",
      "monokai-pro": "custom:monokai-pro:monokai-pro",
      "github-dark": "custom:github:github-dark-default",
      "github-light": "custom:github:github-light-default",
      "github-dark-dimmed": "custom:github:github-dark-dimmed"
    },
    "apply": "Set-DFClaudeTheme"
  },
  "aliases": {
    "cc": { "command": "claude", "ifFree": true },
    "ccc": { "command": "claude", "args": ["--continue"], "ifFree": true },
    "ccr": { "command": "claude", "args": ["--resume"], "ifFree": true }
  },
  "picker": null
}
