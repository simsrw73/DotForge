{
  "name": "pipx",
  "description": "Installs Python applications, each in its own isolated environment",
  "tags": ["python", "dev", "package-manager"],
  "executable": "pipx",
  "roles": { "python-package-manager": { "priority": 20 } },
  "requires": ["role:python-runtime"],
  "packages": { "scoop": "pipx", "pypi": "pipx" },
  "installs": { "from": "pypi", "install": ["pipx", "install", "{id}"], "update": ["pipx", "upgrade", "{id}"], "remove": ["pipx", "uninstall", "{id}"], "list": "Get-DFPipxInstalled", "batch": true },
  "xdg": {
    "compliance": "full",
    "method": "env",
    "vars": {
      "PIPX_HOME": "${XDG_DATA_HOME}/pipx"
    },
    "native": {
      "PIPX_HOME": { "paths": ["${LOCALAPPDATA}/pipx/pipx", "${HOME}/pipx"], "move": false, "block": false, "guide": "pipx's old home holds the environments of the apps it installed: run pipx list with PIPX_HOME pointing there, reinstall them, then delete it." }
    },
    "dirs": ["${XDG_DATA_HOME}/pipx"]
  },
  "aliases": {},
  "picker": null
}
