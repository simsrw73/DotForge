{
  "name": "fzf",
  "description": "General-purpose command-line fuzzy finder",
  "tags": [
    "fuzzy",
    "picker",
    "search"
  ],
  "executable": "fzf.exe",
  "roles": { "picker": { "priority": 10, "env": { "Picker": "fzf" } }, "history-search": { "priority": 10 }, "path-insert": { "priority": 10 }, "directory-jump": { "priority": 10 }, "fuzzy-finder": {} },
  "packages": {
    "scoop": "fzf",
    "winget": "junegunn.fzf",
    "choco": "fzf"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": { "FZF_DEFAULT_OPTS_FILE": "${XDG_CONFIG_HOME}/fzf/fzfrc" },
    "native": { "FZF_DEFAULT_OPTS_FILE": [], "${XDG_CONFIG_HOME}/fzf/fzfrc": [] }
  },
  "setup": {
    "seed": { "${XDG_CONFIG_HOME}/fzf/fzfrc": "fzf/fzfrc" }
  },
  "env": {
    "FZF_DEFAULT_COMMAND": "fd --type f --strip-cwd-prefix --hidden --follow --exclude .git",
    "FZF_ALT_C_COMMAND": "fd --type d --strip-cwd-prefix --hidden --follow --exclude .git",
    "FZF_ALT_C_OPTS": "--preview \"eza --tree --level=2 --color=always {}\"",
    "FZF_CTRL_T_COMMAND": "fd --type f --strip-cwd-prefix --hidden --follow --exclude .git",
    "FZF_CTRL_T_OPTS": "--preview \"bat -n --color=always {}\" --bind 'ctrl-/:change-preview-window(down|hidden|)'"
  },
  "theme": { "key": "FzfTheme", "default": "catppuccin-mocha", "command": "Invoke-DFApplyFzfTheme" },
  "aliases": {},
  "picker": null
}
