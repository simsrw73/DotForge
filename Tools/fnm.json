{
  "name": "fnm",
  "description": "Fast Node.js version manager with automatic per-directory switching",
  "tags": [
    "node",
    "javascript",
    "version-manager",
    "dev"
  ],
  "executable": "fnm.exe",
  "roles": { "version-manager": {}, "js-runtime": { "priority": 20 } },
  "packages": {
    "scoop": "fnm",
    "winget": "Schniz.fnm",
    "choco": "fnm"
  },
  "after": ["zoxide"],
  "installs": { "from": "fnm", "command": ["fnm", "install", "{id}"], "reactivate": true },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "FNM_DIR": "${XDG_DATA_HOME}/fnm"
    },
    "dirs": [
      "${XDG_DATA_HOME}/fnm"
    ]
  },
  "aliases": {},
  "picker": null
}
