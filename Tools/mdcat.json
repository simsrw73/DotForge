{
  "name": "mdcat",
  "description": "cat for markdown — render CommonMark in the terminal",
  "tags": [
    "markdown",
    "viewer",
    "text"
  ],
  "executable": "mdcat.exe",
  "roles": { "markdown-viewer": {} },
  "packages": {
    "scoop": "mdcat",
    "crates": "mdcat"
  },
  "xdg": {
    "compliance": "full",
    "method": "default"
  },
  "theme": {
    "key": "MdcatTheme",
    "default": "catppuccin-mocha",
    "valid": ["auto", "dark", "light", "catppuccin-mocha", "catppuccin-latte", "gruvbox-dark", "gruvbox-light", "dracula", "nord", "solarized-dark", "solarized-light"],
    "fallback": "auto",
    "env": { "MDCAT_THEME": "{theme}" }
  },
  "aliases": {},
  "picker": null
}
