{
  "name": "moor",
  "executable": "moor.exe",
  "description": "Pager that does the right thing without configuration (formerly moar)",
  "tags": ["pager", "viewer"],
  "packages": { "scoop": "moor" },
  "xdg": { "compliance": "none", "method": "default" },
  "theme": { "key": "MoorTheme", "default": "catppuccin-mocha", "env": { "MOOR": "-style {theme}" } },
  "roles": { "pager": { "priority": 30, "flags": { "quit-if-one-screen": ["-quit-if-one-screen"], "raw-color": [], "keep-screen": ["-no-clear-on-exit"], "mouse": ["-mousemode", "scroll"], "theme": [] } } },
  "aliases": {},
  "picker": null
}
