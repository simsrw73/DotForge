{
  "name": "micro",
  "description": "Modern and intuitive terminal-based text editor",
  "tags": [
    "editor",
    "text"
  ],
  "executable": "micro.exe",
  "roles": { "editor": { "priority": 10, "env": { "EDITOR": "micro", "VISUAL": "micro" } } },
  "packages": {
    "scoop": "micro",
    "choco": "micro"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "MICRO_CONF_DIR": "${XDG_CONFIG_HOME}/micro"
    },
    "dirs": [
      "${XDG_CONFIG_HOME}/micro"
    ]
  },
  "aliases": {},
  "picker": null
}