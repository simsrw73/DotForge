{
  "name": "bat",
  "description": "Modern cat replacement with syntax highlighting and Git integration",
  "tags": [
    "viewer",
    "pager",
    "file"
  ],
  "executable": "bat.exe",
  "roles": { "pager": { "priority": 10, "env": { "PAGER": "bat --paging=always --style=plain" } } },
  "packages": {
    "scoop": "bat",
    "winget": "sharkdp.bat",
    "choco": "bat"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "BAT_CONFIG_PATH": "${XDG_CONFIG_HOME}/bat/bat.conf"
    },
    "dirs": []
  },
  "env": {
    "BAT_THEME": "Catppuccin Mocha"
  },
  "themeMap": {
    "catppuccin-mocha": "Catppuccin Mocha"
  },
  "aliases": {
    "cat": {
      "command": "bat",
      "args": [
        "-pp"
      ]
    }
  },
  "picker": null
}