{
  "name": "rustup",
  "description": "Rust toolchain installer and version manager",
  "tags": [
    "rust",
    "dev",
    "toolchain"
  ],
  "executable": "rustup.exe",
  "roles": { "version-manager": {} },
  "packages": {
    "scoop": "rustup",
    "winget": "Rustlang.Rustup"
  },
  "xdg": {
    "compliance": "partial",
    "method": "env",
    "vars": {
      "RUSTUP_HOME": "${XDG_DATA_HOME}/rustup",
      "CARGO_HOME": "${XDG_DATA_HOME}/cargo"
    },
    "dirs": [
      "${XDG_DATA_HOME}/rustup",
      "${XDG_DATA_HOME}/cargo"
    ]
  },
  "aliases": {},
  "picker": {
    "alias": "frtc",
    "function": "Select-RustupToolchain",
    "list": "rustup toolchain list",
    "header": "Select Rust toolchain  [Enter to make it the default]",
    "parse": "($_ -split '\\s+')[0]",
    "action": "rustup default {}"
  }
}