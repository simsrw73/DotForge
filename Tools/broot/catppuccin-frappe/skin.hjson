# Catppuccin frappe for broot, generated by build/New-DFCatppuccinThemes.ps1 from broot's own mocha skin.
###############################################################
# A skin for a terminal with a dark background
# This skin uses RGB values so won't work for some
# terminals.
#
# Created by A. Taha Baki <atahabaki@pm.me>
# Based on the built-in gruvbox theme.
#
# Doc at https://dystroy.org/broot/skins/
###############################################################

skin: {
    input: rgb(198, 208, 245) none
    # fg:none bg:$surface2
    selected_line: none rgb(98, 104, 128) 
    # fg:$text bg:none
    default: rgb(198, 208, 245) none
    # fg:$overlay0 bg:none
    tree: rgb(115, 121, 148) none
    # fg:$sapphire bg:none
    parent: rgb(133, 193, 220) none
    file: none none
#
### PERMISSIONS
#
    perm__: rgb(181, 191, 226) none
    # $peach
    perm_r: rgb(239, 159, 118) none
    # $maroon
    perm_w: rgb(234, 153, 156) none
    # $green
    perm_x: rgb(166, 209, 137) none
    # $teal
    owner: rgb(129, 200, 190) none
    # $sky
    group: rgb(153, 209, 219) none
#
### DATE
#
    # $subtext1
    dates: rgb(181, 191, 226) none
#
### DIRECTORY
#
    # $lavender
    directory: rgb(186, 187, 241) none Bold
    # $green
    exe: rgb(166, 209, 137) none
    # $yellow
    link: rgb(229, 200, 144) none
    # $subtext0
    pruning: rgb(165, 173, 206) none Italic
#
### PREVIEW
#
    # fg:$text bg:$mantle
    preview_title: rgb(198, 208, 245) rgb(41, 44, 60)
    # fg:$text bg:$mantle
    preview: rgb(198, 208, 245) rgb(41, 44, 60)
    # fg:$overlay0
    preview_line_number: rgb(115, 121, 148) none
    # fg:$overlay0
    preview_separator: rgb(115, 121, 148) none
#
### MATCH
#
    char_match: rgb(229, 200, 144) rgb(81, 87, 109) Bold Italic
    content_match: rgb(229, 200, 144) rgb(81, 87, 109) Bold Italic
    preview_match: rgb(229, 200, 144) rgb(81, 87, 109) Bold Italic
    diff_line_number: rgb(115, 121, 148) rgb(65, 69, 89)
    diff_added: rgb(166, 209, 137) none
    diff_removed: rgb(231, 130, 132) none

    # children count
    # fg:$yellow bg:none
    count: rgb(229, 200, 144) none
    sparse: rgb(231, 130, 132) none
    content_extract: rgb(231, 130, 132) none Italic
#
### GIT
#
    git_branch: rgb(239, 159, 118) none
    git_insertions: rgb(239, 159, 118) none
    git_deletions: rgb(239, 159, 118) none
    git_status_current: rgb(239, 159, 118) none
    git_status_modified: rgb(239, 159, 118) none
    git_status_staged: rgb(239, 159, 118) none
    git_status_new: rgb(239, 159, 118) none Bold
    git_status_ignored: rgb(239, 159, 118) none
    git_status_conflicted: rgb(239, 159, 118) none
    git_status_other: rgb(239, 159, 118) none
    staging_area_title: rgb(239, 159, 118) none
#
### FLAG
#
    flag_label: rgb(231, 130, 132) none
    flag_value: rgb(231, 130, 132) none Bold
#
### STATUS
#
    # fg:none #bg:$mantle
    status_normal: none rgb(41, 44, 60)
    # fg:$red bg:$mantle
    status_italic: rgb(231, 130, 132) rgb(41, 44, 60) Italic
    # fg:$maroon bg:$mantle
    status_bold: rgb(234, 153, 156) rgb(41, 44, 60) Bold
    # fg:$maroon bg:$mantle
    status_ellipsis: rgb(234, 153, 156) rgb(41, 44, 60) Bold
    # fg:$text bg:$red
    status_error: rgb(198, 208, 245) rgb(231, 130, 132)
    # fg:$maroon bg:$mantle
    status_job: rgb(234, 153, 156) rgb(41, 44, 60)
    # fg:$maroon bg:$mantle
    status_code: rgb(234, 153, 156) rgb(41, 44, 60) Italic
    # fg:$maroon bg:$mantle
    mode_command_mark: rgb(234, 153, 156) rgb(41, 44, 60) Bold
#
### HELP
#
    # fg:$text
    help_paragraph: rgb(198, 208, 245) none
    # fg:$red
    help_headers: rgb(231, 130, 132) none Bold
    # fg:$peach
    help_bold: rgb(239, 159, 118) none Bold
    # fg:$yellow
    help_italic: rgb(229, 200, 144) none Italic
    # fg:green bg:$surface0
    help_code: rgb(166, 209, 137) rgb(65, 69, 89)
    # fg:$overlay0
    help_table_border: rgb(115, 121, 148) none
#
### HEX
#
    # fg:$text
    hex_null: rgb(198, 208, 245) none
    # fg:$peach
    hex_ascii_graphic: rgb(239, 159, 118) none
    # fg:$green
    hex_ascii_whitespace: rgb(166, 209, 137) none
    # fg: teal
    hex_ascii_other: rgb(129, 200, 190) none
    # fg: red
    hex_non_ascii: rgb(231, 130, 132) none

    # fg:$text bg:$red
    file_error: rgb(231, 130, 132) none
#
### PURPOSE
#
    purpose_normal: none none
    purpose_italic: rgb(244, 184, 228) none Italic
    purpose_bold: rgb(244, 184, 228) none Bold
    purpose_ellipsis: none none
#
### SCROLLBAR
#
    # fg:$surface0
    scrollbar_track: rgb(65, 69, 89) none
    # fg:$surface1
    scrollbar_thumb: rgb(98, 104, 128) none
#
### GOODTOBAD
#
    good_to_bad_0: rgb(166, 209, 137) none
    good_to_bad_1: rgb(129, 200, 190) none
    good_to_bad_2: rgb(153, 209, 219) none
    good_to_bad_3: rgb(133, 193, 220) none
    good_to_bad_4: rgb(140, 170, 238) none
    good_to_bad_5: rgb(186, 187, 241) none
    good_to_bad_6: rgb(202, 158, 230) none
    good_to_bad_7: rgb(239, 159, 118) none
    good_to_bad_8: rgb(234, 153, 156) none
    good_to_bad_9: rgb(231, 130, 132) none
}
