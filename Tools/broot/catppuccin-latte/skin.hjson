# Catppuccin latte for broot, generated by build/New-DFCatppuccinThemes.ps1 from broot's own mocha skin.
###############################################################
# A skin for a terminal with a dark background
# This skin uses RGB values so won't work for some
# terminals.
#
# Created by A. Taha Baki <atahabaki@pm.me>
# Based on the built-in gruvbox theme.
#
# Doc at https://dystroy.org/broot/skins/
###############################################################

skin: {
    input: rgb(76, 79, 105) none
    # fg:none bg:$surface2
    selected_line: none rgb(172, 176, 190) 
    # fg:$text bg:none
    default: rgb(76, 79, 105) none
    # fg:$overlay0 bg:none
    tree: rgb(156, 160, 176) none
    # fg:$sapphire bg:none
    parent: rgb(32, 159, 181) none
    file: none none
#
### PERMISSIONS
#
    perm__: rgb(92, 95, 119) none
    # $peach
    perm_r: rgb(254, 100, 11) none
    # $maroon
    perm_w: rgb(230, 69, 83) none
    # $green
    perm_x: rgb(64, 160, 43) none
    # $teal
    owner: rgb(23, 146, 153) none
    # $sky
    group: rgb(4, 165, 229) none
#
### DATE
#
    # $subtext1
    dates: rgb(92, 95, 119) none
#
### DIRECTORY
#
    # $lavender
    directory: rgb(114, 135, 253) none Bold
    # $green
    exe: rgb(64, 160, 43) none
    # $yellow
    link: rgb(223, 142, 29) none
    # $subtext0
    pruning: rgb(108, 111, 133) none Italic
#
### PREVIEW
#
    # fg:$text bg:$mantle
    preview_title: rgb(76, 79, 105) rgb(230, 233, 239)
    # fg:$text bg:$mantle
    preview: rgb(76, 79, 105) rgb(230, 233, 239)
    # fg:$overlay0
    preview_line_number: rgb(156, 160, 176) none
    # fg:$overlay0
    preview_separator: rgb(156, 160, 176) none
#
### MATCH
#
    char_match: rgb(223, 142, 29) rgb(188, 192, 204) Bold Italic
    content_match: rgb(223, 142, 29) rgb(188, 192, 204) Bold Italic
    preview_match: rgb(223, 142, 29) rgb(188, 192, 204) Bold Italic
    diff_line_number: rgb(156, 160, 176) rgb(204, 208, 218)
    diff_added: rgb(64, 160, 43) none
    diff_removed: rgb(210, 15, 57) none

    # children count
    # fg:$yellow bg:none
    count: rgb(223, 142, 29) none
    sparse: rgb(210, 15, 57) none
    content_extract: rgb(210, 15, 57) none Italic
#
### GIT
#
    git_branch: rgb(254, 100, 11) none
    git_insertions: rgb(254, 100, 11) none
    git_deletions: rgb(254, 100, 11) none
    git_status_current: rgb(254, 100, 11) none
    git_status_modified: rgb(254, 100, 11) none
    git_status_staged: rgb(254, 100, 11) none
    git_status_new: rgb(254, 100, 11) none Bold
    git_status_ignored: rgb(254, 100, 11) none
    git_status_conflicted: rgb(254, 100, 11) none
    git_status_other: rgb(254, 100, 11) none
    staging_area_title: rgb(254, 100, 11) none
#
### FLAG
#
    flag_label: rgb(210, 15, 57) none
    flag_value: rgb(210, 15, 57) none Bold
#
### STATUS
#
    # fg:none #bg:$mantle
    status_normal: none rgb(230, 233, 239)
    # fg:$red bg:$mantle
    status_italic: rgb(210, 15, 57) rgb(230, 233, 239) Italic
    # fg:$maroon bg:$mantle
    status_bold: rgb(230, 69, 83) rgb(230, 233, 239) Bold
    # fg:$maroon bg:$mantle
    status_ellipsis: rgb(230, 69, 83) rgb(230, 233, 239) Bold
    # fg:$text bg:$red
    status_error: rgb(76, 79, 105) rgb(210, 15, 57)
    # fg:$maroon bg:$mantle
    status_job: rgb(230, 69, 83) rgb(230, 233, 239)
    # fg:$maroon bg:$mantle
    status_code: rgb(230, 69, 83) rgb(230, 233, 239) Italic
    # fg:$maroon bg:$mantle
    mode_command_mark: rgb(230, 69, 83) rgb(230, 233, 239) Bold
#
### HELP
#
    # fg:$text
    help_paragraph: rgb(76, 79, 105) none
    # fg:$red
    help_headers: rgb(210, 15, 57) none Bold
    # fg:$peach
    help_bold: rgb(254, 100, 11) none Bold
    # fg:$yellow
    help_italic: rgb(223, 142, 29) none Italic
    # fg:green bg:$surface0
    help_code: rgb(64, 160, 43) rgb(204, 208, 218)
    # fg:$overlay0
    help_table_border: rgb(156, 160, 176) none
#
### HEX
#
    # fg:$text
    hex_null: rgb(76, 79, 105) none
    # fg:$peach
    hex_ascii_graphic: rgb(254, 100, 11) none
    # fg:$green
    hex_ascii_whitespace: rgb(64, 160, 43) none
    # fg: teal
    hex_ascii_other: rgb(23, 146, 153) none
    # fg: red
    hex_non_ascii: rgb(210, 15, 57) none

    # fg:$text bg:$red
    file_error: rgb(210, 15, 57) none
#
### PURPOSE
#
    purpose_normal: none none
    purpose_italic: rgb(234, 118, 203) none Italic
    purpose_bold: rgb(234, 118, 203) none Bold
    purpose_ellipsis: none none
#
### SCROLLBAR
#
    # fg:$surface0
    scrollbar_track: rgb(204, 208, 218) none
    # fg:$surface1
    scrollbar_thumb: rgb(172, 176, 190) none
#
### GOODTOBAD
#
    good_to_bad_0: rgb(64, 160, 43) none
    good_to_bad_1: rgb(23, 146, 153) none
    good_to_bad_2: rgb(4, 165, 229) none
    good_to_bad_3: rgb(32, 159, 181) none
    good_to_bad_4: rgb(30, 102, 245) none
    good_to_bad_5: rgb(114, 135, 253) none
    good_to_bad_6: rgb(136, 57, 239) none
    good_to_bad_7: rgb(254, 100, 11) none
    good_to_bad_8: rgb(230, 69, 83) none
    good_to_bad_9: rgb(210, 15, 57) none
}
